# 서버 전용 파일. --live 없는 배포 구성은 실제 송신하지 않는다.
XFOLIO_WORKER_DATABASE_URL=postgresql+psycopg://WORKER_ROLE:PASSWORD@NEON_HOST/xfolio?sslmode=verify-full
XFOLIO_RECIPIENT_SCOPE=self
XFOLIO_MONTHLY_BUDGET_KRW=50000
XFOLIO_WORKER_LIVE_ACCEPTED=false
XFOLIO_TELEGRAM_BOT_TOKEN=
XFOLIO_TELEGRAM_CHAT_ID=
# 실제 수집 연결. 기본 Compose는 이 값만으로 live를 활성화하지 않는다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
FINNHUB_API_KEY=
OPENAI_API_KEY=
# 호스트의 유효한 GenerationLimits JSON을 별도 읽기 전용 mount한 컨테이너 경로.
XFOLIO_GENERATION_LIMITS_FILE=/run/secrets/generation_limits.json
