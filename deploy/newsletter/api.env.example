# 서버 전용 파일. 실제 파일은 저장소 밖 /etc/xfolio/api.env 에 둔다.
XFOLIO_API_DATABASE_URL=postgresql+psycopg://API_ROLE:PASSWORD@NEON_HOST/xfolio?sslmode=verify-full
XFOLIO_PUBLIC_ORIGIN=https://SERVER.TAILNET.ts.net
XFOLIO_GOOGLE_CLIENT_ID=
XFOLIO_GOOGLE_CLIENT_SECRET=
XFOLIO_ALLOWED_EMAILS=OWNER_EMAIL
XFOLIO_API_CURSOR_SECRET=
# API 환경에는 KIS/Finnhub/OpenAI/Telegram 비밀을 넣지 않는다.
