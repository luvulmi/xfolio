{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	@health path /healthz
	handle @health {
		respond "ok" 200
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		header Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
}
