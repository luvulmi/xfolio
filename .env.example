# 실제 비밀 값은 .env 또는 서버 실행 환경에만 설정합니다.
# 현재 뉴스레터에 필요한 설정입니다. 운영 인수 전 기본 모의 실행입니다.

# 공식 발표 AI 요약: 모델은 코드의 기본값/실행 옵션을 사용합니다.
OPENAI_API_KEY=

# 일반 뉴스: 본인 개인용 채택. 별도 이메일은 필수 아님, 정시 관측은 후속입니다.
FINNHUB_API_KEY=

# KIS 국내 ETF 시세 조회. 실전 서비스용으로 발급한 앱 키를 입력합니다.
# 주문은 사용하지 않으며 계좌번호·HTS ID·만료되는 access token은 넣지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 기존 개발 도구용 본인 1:1 Telegram 설정입니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 신규 worker 전용. 기본 mock; --live는 서버 인수 설정을 요구합니다.
# worker는 .env를 자동으로 읽지 않으므로 서버 프로세스 환경에 주입합니다.
XFOLIO_WORKER_DATABASE_URL=
XFOLIO_TELEGRAM_BOT_TOKEN=
XFOLIO_TELEGRAM_CHAT_ID=
XFOLIO_RECIPIENT_SCOPE=self
XFOLIO_MONTHLY_BUDGET_KRW=50000
XFOLIO_WORKER_LIVE_ACCEPTED=false
# 실제 수집/예약용 GenerationLimits JSON 절대 경로. 유효 단가·근거/만료시각 필수.
XFOLIO_GENERATION_LIMITS_FILE=
# 만료 검사/삭제 전용 역할. 기본 plan은 DB에 연결하지 않습니다.
XFOLIO_MAINTENANCE_DATABASE_URL=

# FastAPI 관리자: .env는 실행 시 --env-file로 명시합니다.
XFOLIO_API_DATABASE_URL=
XFOLIO_PUBLIC_ORIGIN=https://localhost:8443
XFOLIO_GOOGLE_CLIENT_ID=
XFOLIO_GOOGLE_CLIENT_SECRET=
XFOLIO_ALLOWED_EMAILS=
XFOLIO_API_CURSOR_SECRET=
XFOLIO_MODE=dry_run

# DDL 전용 역할. API 역할/기존 preview DB와 분리합니다.
XFOLIO_MIGRATION_DATABASE_URL=
# 격리된 일회용 시험 PostgreSQL 전용. 실제 서비스 DB를 넣지 마세요.
XFOLIO_TEST_DATABASE_URL=
