  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "hold"
            ],
            "title": "Action"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "expected_decision_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Decision Revision"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "review_checks": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewChecks"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "expected_version",
          "expected_decision_revision"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResult": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "applied": {
            "type": "boolean",
            "title": "Applied"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "decision_revision": {
            "type": "integer",
            "title": "Decision Revision"
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "validated",
              "approved",
              "scheduled",
              "sending",
              "published",
              "held",
              "failed",
              "partial",
              "unknown",
              "expired"
            ],
            "title": "Status"
          },
          "original_result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "applied",
          "replayed",
          "version",
          "decision_revision",
          "status"
        ],
        "title": "DecisionResult"
      },
      "DraftDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "title": "Target Date"
          },
          "edition": {
            "type": "string",
            "enum": [
              "AM",
              "PM"
            ],
            "title": "Edition"
          },
          "market_trade_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Trade Date"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "decision_revision": {
            "type": "integer",
            "title": "Decision Revision"
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "validated",
              "approved",
              "scheduled",
              "sending",
              "published",
              "held",
              "failed",
              "partial",
              "unknown",
              "expired"
            ],
            "title": "Status"
          },
          "news_count": {
            "type": "integer",
            "title": "News Count"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "dry_run",
              "reviewed",
              "auto"
            ],
            "title": "Mode"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "transport_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mock",
                  "live"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Transport Mode"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "frozen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frozen At"
          },
          "posts": {
            "items": {
              "$ref": "#/components/schemas/Post"
            },
            "type": "array",
            "title": "Posts"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions"
          },
          "publication": {
            "additionalProperties": true,
            "type": "object",
            "title": "Publication"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History",
            "default": []
          },
          "hold_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hold Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "target_date",
          "edition",
          "version",
          "decision_revision",
          "status",
          "news_count",
          "scheduled_at",
          "expires_at",
          "mode",
          "synthetic",
          "validation",
          "posts",
          "allowed_actions"
        ],
        "title": "DraftDetail"
      },
